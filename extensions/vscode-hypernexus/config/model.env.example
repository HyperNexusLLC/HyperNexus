# Model wiring for HyperNexus on VS Code (Meta provider).
# No credentials live here — only the provider + model id NAMES. Auth stays
# in the user's saved provider login; never paste tokens into this file.
HYPERNEXUS_MODEL_PROVIDER=meta
HYPERNEXUS_MODEL=muse-spark-1.3-contributor

# VS Code settings equivalent (see package.json contributes.configuration):
#   "hypernexus.modelProvider": "meta",
#   "hypernexus.model": "muse-spark-1.3-contributor",
#   "hypernexus.serverUrl": "http://127.0.0.1:7778"
