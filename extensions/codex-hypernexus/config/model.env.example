# Model wiring for HyperNexus on Codex (Meta provider).
# No credentials live here — only the model id NAME. The API key stays in
# the shell environment (MODEL_API_KEY, minted live from pi auth.json);
# never paste tokens into this file.
CODEX_MODEL=meta/muse-spark-1.3-contributor

# config.toml reference (managed by scripts/install.sh authoritatively):
#   model = "meta/muse-spark-1.3-contributor"
#   model_provider = "meta"
#   model_reasoning_effort = "high"
#   model_context_window = 1048576
# Exact user-run activation (PowerShell, key minted live, never stored):
#   $env:MODEL_API_KEY = (node <repo>/addons/codex/bin/meta-muse-key.mjs)
#   codex --model $env:CODEX_MODEL "<prompt>"
