# Model wiring for HyperNexus on Muse Code (Meta provider).
# No credentials live here — only the model id NAME. Auth stays in the
# user's saved provider login; never paste tokens into this file.
METACODE_MODEL=muse-spark-1.3-contributor

# Exact user-run activation (PowerShell). This references the model id
# by environment variable only, per the HyperNexus credential rule:
#   $env:METACODE_MODEL = 'muse-spark-1.3-contributor'
#   muse --provider meta --model $env:METACODE_MODEL --contributor-mode on
# Headless equivalent:
#   muse exec --provider meta --model $env:METACODE_MODEL "<prompt>"
