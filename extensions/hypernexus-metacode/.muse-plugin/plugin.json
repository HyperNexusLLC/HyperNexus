{
  "schemaVersion": 1,
  "name": "hypernexus-metacode",
  "displayName": "HyperNexus for Meta Code",
  "version": "0.1.0",
  "description": "HyperNexus AI control plane for Meta Code (Muse Code): persistent L2 memory, MCP tool routing, agent dispatch, session management, and kernel status/billing over stdio.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "hypernexus",
        "path": "skills/hypernexus/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "hypernexus-ops",
        "path": "skills/hypernexus-ops/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "hypernexus-workflows",
        "path": "skills/hypernexus-workflows/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "hypernexus-sessions",
        "path": "skills/hypernexus-sessions/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "hn-status",
        "path": "commands/hn-status.md",
        "enabledDefault": true
      },
      {
        "id": "hn-memory",
        "path": "commands/hn-memory.md",
        "enabledDefault": true
      },
      {
        "id": "hn-tools",
        "path": "commands/hn-tools.md",
        "enabledDefault": true
      },
      {
        "id": "hn-session",
        "path": "commands/hn-session.md",
        "enabledDefault": true
      },
      {
        "id": "hn-billing",
        "path": "commands/hn-billing.md",
        "enabledDefault": true
      },
      {
        "id": "hn-ops",
        "path": "commands/hn-ops.md",
        "enabledDefault": true
      },
      {
        "id": "hn-search",
        "path": "commands/hn-search.md",
        "enabledDefault": true
      },
      {
        "id": "hn-handoff",
        "path": "commands/hn-handoff.md",
        "enabledDefault": true
      },
      {
        "id": "hn-context",
        "path": "commands/hn-context.md",
        "enabledDefault": true
      },
      {
        "id": "hn-purge",
        "path": "commands/hn-purge.md",
        "enabledDefault": true
      },
      {
        "id": "hn-agent",
        "path": "commands/hn-agent.md",
        "enabledDefault": true
      },
      {
        "id": "hn-workflow",
        "path": "commands/hn-workflow.md",
        "enabledDefault": true
      }
    ],
    "hooks": [
      {
        "id": "hn-session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/hn-session-start.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Logging session to HyperNexus"
      },
      {
        "id": "hn-pre-tool-use",
        "event": "PreToolUse",
        "command": [
          "sh",
          "hooks/hn-pre-tool-use.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Recalling HyperNexus memory context"
      },
      {
        "id": "hn-post-tool-use",
        "event": "PostToolUse",
        "command": [
          "sh",
          "hooks/hn-post-tool-use.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Recording tool context in HyperNexus"
      },
      {
        "id": "hn-session-end",
        "event": "SessionEnd",
        "command": [
          "sh",
          "hooks/hn-session-end.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Capturing HyperNexus session summary"
      },
      {
        "id": "hn-user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": [
          "sh",
          "hooks/hn-user-prompt-submit.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Capturing prompt in HyperNexus"
      },
      {
        "id": "hn-stop",
        "event": "Stop",
        "command": [
          "sh",
          "hooks/hn-stop.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Recording turn end in HyperNexus"
      },
      {
        "id": "hn-permission-request",
        "event": "PermissionRequest",
        "command": [
          "sh",
          "hooks/hn-permission-request.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Logging permission request in HyperNexus"
      },
      {
        "id": "hn-pre-compact",
        "event": "PreCompact",
        "command": [
          "sh",
          "hooks/hn-pre-compact.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Checkpointing context in HyperNexus"
      },
      {
        "id": "hn-post-compact",
        "event": "PostCompact",
        "command": [
          "sh",
          "hooks/hn-post-compact.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Noting compaction in HyperNexus"
      },
      {
        "id": "hn-subagent-start",
        "event": "SubagentStart",
        "command": [
          "sh",
          "hooks/hn-subagent-start.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Logging subagent start in HyperNexus"
      },
      {
        "id": "hn-subagent-stop",
        "event": "SubagentStop",
        "command": [
          "sh",
          "hooks/hn-subagent-stop.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Logging subagent finish in HyperNexus"
      },
      {
        "id": "hn-interrupt",
        "event": "Interrupt",
        "command": [
          "sh",
          "hooks/hn-interrupt.sh"
        ],
        "timeoutMs": 5000,
        "statusMessage": "Passing interrupt through",
        "async": true
      }
    ],
    "mcpServers": [
      {
        "id": "hypernexus",
        "transport": "stdio",
        "command": [
          "sh",
          "mcp/stdio.sh"
        ]
      }
    ],
    "reminders": [
