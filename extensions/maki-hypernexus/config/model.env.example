# Model wiring for HyperNexus on maki (Meta provider).
# No credentials live here — only the model id NAME. Auth stays in the
# user's saved provider login (`maki auth` / `maki mcp auth` flows);
# never paste tokens into this file.
MAKI_MODEL=meta/muse-spark-1.3-contributor

# Exact user-run activation (PowerShell). This references the model id
# by environment variable only, per the HyperNexus credential rule:
#   $env:MAKI_MODEL = 'meta/muse-spark-1.3-contributor'
#   maki -m $env:MAKI_MODEL
# Headless equivalent:
#   maki -p "<prompt>" -m $env:MAKI_MODEL
