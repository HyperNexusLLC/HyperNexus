{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta-hn/muse-spark-1.3-contributor",
  "tools": {
    "bash": false
  },
  "mcp": {
    "servers": {
      "hypernexus": {
        "type": "local",
        "command": [
          "C:\\Users\\hyper\\workspace\\HyperNexus\\bin\\hypernexus.exe",
          "mcp"
        ],
        "environment": {
          "HYPERNEXUS_URL": "http://127.0.0.1:7778",
          "HYPERNEXUS_WORKSPACE_ROOT": "C:\\Users\\hyper\\workspace\\HyperNexus"
        },
        "timeout": {
          "startup": 45000
        }
      }
    }
  },
  "providers": {
    "meta-hn": {
      "name": "Meta (muse-spark via HyperNexus proxy)",
      "env": [
        "META_MUSE_API_KEY"
      ],
      "npm": "@opencode/ai/providers/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:7778/v1"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor",
          "releaseDate": "2026-09-02",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "muse-wonder-1.0-contributor": {
          "name": "Muse Wonder 1.0 Contributor",
          "releaseDate": "2026-09-02",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  },
  "provider": {
    "meta-hn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Meta (muse-spark via HyperNexus proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:7778/v1"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "muse-wonder-1.0-contributor": {
          "name": "Muse Wonder 1.0 Contributor",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  }
}
