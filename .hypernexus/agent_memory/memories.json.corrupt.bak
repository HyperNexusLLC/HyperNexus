      "id": "bc5fec2fdd0fe659",
      "content": "[{\"type\":\"text\",\"text\":\"39: func loadSettings() (SupervisorSettings, error) {\\r\\n68: func saveSettings(s SupervisorSettings) error {\\r\\n672: func simulateInput(keys, windowTitle string) ToolResult {\\r\\n686: func escapeSendKeys(s string) string {\\r\\n719: func setChatInput(args map[string]any) ToolResult {\\r\\n733: func submitChatInput(args map[string]any) ToolResult {\\r\\n746: func clickActionButtons(args map[string]any) ToolResult {\\r\\n759: func advanceChat(args map[string]any) ToolResult {\\r\\n\"}]",
