#!/bin/bash
# HyperNexus Auto-Updater
# Checks for new versions and updates automatically
# Usage: hypernexus-update [--check] [--force]

set -e

REPO="robertpelloni/HyperNexus"
VERSION_URL="https://releases.hypernexus.site/latest/version.json"
INSTALL_DIR="${HOME}/.hypernexus"
VERSION_FILE="${INSTALL_DIR}/current_version"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Detect platform
detect_platform() {
    local os arch
    case "$(uname -s)" in
        Linux*)  os="linux" ;;
        Darwin*) os="darwin" ;;
        CYWIN*|MINGW*|MSYS*) os="windows" ;;
        *) echo -e "${RED}Unsupported platform$(NC)"; exit 1 ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch="amd64" ;;
        arm64|aarch64) arch="arm64" ;;
        *) arch="amd64" ;;
    esac
    echo "${os}-${arch}"
}

# Get current version
get_current_version() {
    if [ -f "$VERSION_FILE" ]; then
        cat "$VERSION_FILE" | tr -d '[:space:]'
    elif command -v hypernexus &>/dev/null; then
        hypernexus --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
    else
        echo "0.0.0"
    fi
}

# Get latest version from server
get_latest_version() {
    local response
    if command -v curl &>/dev/null; then
        response=$(curl -fsSL "$VERSION_URL" 2>/dev/null)
    elif command -v wget &>/dev/null; then
        response=$(wget -qO- "$VERSION_URL" 2>/dev/null)
    else
        echo -e "${RED}Error: curl or wget required${NC}"
        exit 1
    fi
    
    if [ -z "$response" ]; then
        echo ""
        return
    fi
    
    echo "$response" | grep -oE '"version"\s*:\s*"[^"]*"' | head -1 | cut -d'"' -f4
}

# Compare versions (returns 1 if $1 > $2)
version_gt() {
    [ "$(printf '%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ] && [ "$1" != "$2" ]
}

# Download and install update
do_update() {
    local version="$1"
    local platform
    platform=$(detect_platform)
    
    echo -e "${CYAN}Downloading HyperNexus ${version}...${NC}"
    
    local url="https://releases.hypernexus.site/${version}/hypernexus"
    local tmpdir
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    
    if [[ "$platform" == windows-* ]]; then
        url="${url}.exe"
        local dest="${tmpdir}/hypernexus.exe"
    else
        local dest="${tmpdir}/hypernexus"
    fi
    
    if command -v curl &>/dev/null; then
        curl -fsSL -o "$dest" "$url"
    else
        wget -qO "$dest" "$url"
    fi
    
    chmod +x "$dest" 2>/dev/null || true
    
    # Backup current
    if command -v hypernexus &>/dev/null; then
        local current_path
        current_path=$(which hypernexus)
        if [ -f "$current_path" ]; then
            cp "$current_path" "${current_path}.bak" 2>/dev/null || true
        fi
    fi
    
    # Install
    mkdir -p "$INSTALL_DIR"
    cp "$dest" "$INSTALL_DIR/hypernexus"
    
    # Update PATH if needed
    if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        export PATH="$INSTALL_DIR:$PATH"
        
        # Add to shell profile
        local shell_rc="$HOME/.bashrc"
        [ -f "$HOME/.zshrc" ] && shell_rc="$HOME/.zshrc"
        
        if ! grep -q "$INSTALL_DIR" "$shell_rc" 2>/dev/null; then
            echo "export PATH=\"$INSTALL_DIR:\$PATH\"" >> "$shell_rc"
        fi
    fi
    
    # Create symlink
    if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
        ln -sf "$INSTALL_DIR/hypernexus" /usr/local/bin/hypernexus 2>/dev/null || true
    fi
    
    # Save version
    echo "$version" > "$VERSION_FILE"
    
    echo -e "${GREEN}✅ HyperNexus ${version} installed!${NC}"
}

# Main
main() {
    local check_only=false
    local force=false
    
    for arg in "$@"; do
        case "$arg" in
            --check|-c) check_only=true ;;
            --force|-f) force=true ;;
            --help|-h)
                echo "Usage: hypernexus-update [--check] [--force]"
                echo "  --check  Check for updates without installing"
                echo "  --force  Force update even if already up to date"
                exit 0
                ;;
        esac
    done
    
    echo -e "${CYAN}HyperNexus Update Manager${NC}"
    echo ""
    
    local current
    current=$(get_current_version)
    echo -e "Current version: ${YELLOW}${current}${NC}"
    
    local latest
    latest=$(get_latest_version)
    
    if [ -z "$latest" ]; then
        echo -e "${RED}Error: Could not check for updates${NC}"
        exit 1
    fi
    
    echo -e "Latest version:  ${GREEN}${latest}${NC}"
    echo ""
    
    if [ "$check_only" = true ]; then
        if version_gt "$latest" "$current"; then
            echo -e "${YELLOW}Update available: ${latest}${NC}"
            exit 0
        else
            echo -e "${GREEN}Already up to date!${NC}"
            exit 0
        fi
    fi
    
    if [ "$force" = true ] || version_gt "$latest" "$current"; then
        echo -e "${YELLOW}Updating to ${latest}...${NC}"
        do_update "$latest"
    else
        echo -e "${GREEN}Already up to date!${NC}"
    fi
}

main "$@"
