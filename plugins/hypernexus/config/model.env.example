# Model wiring for HyperNexus on Claude Code (Meta provider).
# No credentials live here — only the model id NAME. Auth stays in the
# user's saved provider login or the kernel's pi-OAuth path; never paste
# tokens into this file.
ANTHROPIC_MODEL=muse-spark-1.3-contributor

# NATIVE PATH (no minting): the kernel reads the pi Meta OAuth identity
# per request and forwards to https://api.meta.ai/v1/chat/completions.
#   ~/.claude/settings.json:
#     { "env": {
#         "ANTHROPIC_BASE_URL": "http://127.0.0.1:7778",
#         "ANTHROPIC_API_KEY": "hypernexus-local",
#         "ANTHROPIC_MODEL": "muse-spark-1.3-contributor" } }
# Exact user-run activation (PowerShell):
#   $env:ANTHROPIC_MODEL = 'muse-spark-1.3-contributor'
#   claude --plugin-dir <path-to>/plugins/hypernexus --model $env:ANTHROPIC_MODEL "<prompt>"
