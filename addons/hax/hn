#!/usr/bin/env node
/**
 * hn — self-locating HyperNexus CLI wrapper (node shebang)
 * ========================================================
 * `node` is not always on PATH inside agent-turn shells (MSYS/Git-Bash).
 * This wrapper re-execs itself with the repo's known node locations so the
 * model can call `./addons/hax/hn` (or `hn`) directly. Forwards everything
 * to hn.mjs next to it.
 */
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
const r = spawnSync(process.execPath, [path.join(here, "hn.mjs"), ...process.argv.slice(2)], { stdio: "inherit" });
process.exit(r.status ?? 1);
