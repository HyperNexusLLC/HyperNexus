{
  "apiVersion": "reasonix.io/plugin/v2",
  "name": "hypernexus",
  "version": "1.0.22",
  "description": "HyperNexus AI control plane for Reasonix: persistent L2/L3 memory, semantic MCP tool discovery across 26k+ tools, knowledge graph, sessions, skills, billing, and agent orchestration. Uses tools, intercepts, skills, commands, agents, hooks, and MCP server config.",
  "requires": [],
  "provides": [
    {
      "namespace": "plugin/hypernexus",
      "kind": "interceptors",
      "id": "default",
      "version": "1.0.0"
    }
  ],
  "contributes": {
    "skills": ["skills"],
    "agents": ["agents"],
    "commands": ["commands"],
    "hooks": {
      "SessionStart": [
        {
          "contextFile": "hooks/context/startup.md",
          "description": "HyperNexus session primer: RECALL-first discipline and kernel endpoints"
        }
      ],
      "PreCompact": [
        {
          "contextFile": "hooks/context/precompact.md",
          "description": "HyperNexus compaction guidance: preserve L2 pointers"
        }
      ]
    },
    "mcpServers": {
      "hypernexus": {
        "command": "hypernexus.exe",
        "args": ["mcp"],
        "env": {
          "HYPERNEXUS_URL": "http://127.0.0.1:7778"
        }
      }
    }
  },
  "runtime": {
    "command": "node",
    "args": ["${REASONIX_PLUGIN_ROOT}/runtime/bin/hypernexus-reasonix.mjs"],
    "env": {
      "HYPERNEXUS_URL": "http://127.0.0.1:7778"
    },
    "required": false,
    "priority": 0,
    "intercepts": [
      "input.receive",
      "context.prepare",
      "tool.before",
      "tool.after",
      "permission.decision",
      "session.start",
      "session.end",
      "compaction.prepare",
      "system_prompt.build",
      "agent.before_start"
    ],
    "replaces": [],
    "capabilities": ["interceptors", "tools"],
    "tools": [
      {
        "name": "status",
        "description": "HyperNexus kernel health, version, uptime, and MCP bridge status. Call first when the kernel may be offline.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "system_overview",
        "description": "Full system overview: kernel health, MCP inventory, providers, memory tiers, mesh.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "memory_store",
        "description": "Persist a fact, decision, or gotcha to HyperNexus L2 memory with tags (survives across sessions/tools).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "The memory content." },
            "title": { "type": "string", "description": "Optional short title." },
            "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags, e.g. reasoning,fix." },
            "namespace": { "type": "string", "description": "Namespace: project, global, user." }
          },
          "required": ["content"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "memory_search",
        "description": "Keyword + semantic search across L2 memory (best relevance; slower). For hot loops use memory_fts_search.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search query." },
            "limit": { "type": "number", "description": "Max results (default 8)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "memory_fts_search",
        "description": "FAST keyword search across L2 memory (FTS). Prefer this in latency-sensitive loops.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search query." },
            "limit": { "type": "number", "description": "Max results (default 8)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "memory_vector_search",
        "description": "Semantic vector search over L2 plus L3 cold-archive fallback for older knowledge.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Natural-language query." },
            "limit": { "type": "number", "description": "Max results (default 6)." },
            "cold": { "type": "boolean", "description": "Also search L3 cold archive (default true)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "memory_list",
        "description": "Browse the most recent L2 memories.",
        "inputSchema": {
          "type": "object",
          "properties": { "limit": { "type": "number", "description": "How many (default 10)." } },
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "memory_delete",
        "description": "Delete an L2 memory by id, or every memory carrying a tag (capped fan-out).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "Memory id." },
            "tag": { "type": "string", "description": "Alternative: delete all memories with this tag (max 20)." }
          },
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "memory_relate",
        "description": "Link two memories in the knowledge graph (source_id relation_type target_id) with optional weight.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "source_id": { "type": "string", "description": "Source memory id." },
            "target_id": { "type": "string", "description": "Target memory id." },
            "relation_type": { "type": "string", "description": "Relation, e.g. uses, fixes, supersedes." },
            "weight": { "type": "number", "description": "Strength 0..1 (default 0.8)." }
          },
          "required": ["source_id", "target_id", "relation_type"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "scratchpad",
        "description": "Read/write the L1 scratchpad: short-lived working state shared across harnesses.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["get", "set", "append"], "description": "Operation." },
            "key": { "type": "string", "description": "Scratchpad key, e.g. current_task." },
            "value": { "type": "string", "description": "Value for set/append." }
          },
          "required": ["action", "key"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "context_harvest",
        "description": "Harvest prior context for a task: memories, session summaries, observations. Start complex tasks with this.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": { "type": "string", "description": "Task topic or description." },
            "limit": { "type": "number", "description": "Max items per source (default 5)." }
          },
          "required": ["topic"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "record_observation",
        "description": "Record a structured observation (discovery, decision, progress, warning, fix) with concepts and touched files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "Observation content." },
            "type": { "type": "string", "enum": ["discovery", "decision", "progress", "warning", "fix"] },
            "title": { "type": "string", "description": "Short title." },
            "concepts": { "type": "array", "items": { "type": "string" } },
            "filesRead": { "type": "array", "items": { "type": "string" } },
            "filesModified": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["content"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "tool_search",
        "description": "Semantic discovery across the 26k+ MCP tool catalog. Describe what you need; get the best matching tools.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "What you need, e.g. browser automation." },
            "limit": { "type": "number", "description": "Max results (default 10)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "tool_discover",
        "description": "Query the native MCP router (L1+L2+L3 layers) for tools, returning the working set it would auto-load.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Capability you are looking for." },
            "limit": { "type": "number", "description": "Max results (default 10)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "suggest_tools",
        "description": "Read proactive tool suggestions the preemptive advertiser derived from this conversation.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "mcp_status",
        "description": "MCP bridge status: connected servers, counts, initialization state.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "mcp_servers",
        "description": "List configured + runtime MCP servers with status and tool counts.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "mcp_tools",
        "description": "List MCP tools currently exposed by the kernel bridge.",
        "inputSchema": {
          "type": "object",
          "properties": { "limit": { "type": "number", "description": "Max rows (default 25)." } },
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "mcp_search",
        "description": "Search the live-synced MCP tool inventory (server-qualified tool names and schemas).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search text." },
            "limit": { "type": "number", "description": "Max results (default 10)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "mcp_call",
        "description": "Invoke a discovered MCP tool through the kernel router (server/tool name + args).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool": { "type": "string", "description": "Tool name, e.g. filesystem/read_file." },
            "args": { "type": "object", "description": "Tool arguments.", "additionalProperties": true }
          },
          "required": ["tool"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "session_search",
        "description": "Search imported coding sessions (Claude Code, Aider, Gemini) for prior work and decisions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search text." },
            "limit": { "type": "number", "description": "Max results (default 10)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "session_context",
        "description": "Session bootstrap: active goal, last objective, and cross-session links for the current workspace.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "session_handoff",
        "description": "Persist or restore a session handoff artifact (goal continuity across harnesses).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["write", "pickup"] },
            "summary": { "type": "string", "description": "Handoff summary (required for write)." },
            "artifact": { "type": "string", "description": "Artifact name to restore (optional for pickup)." }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "skill_search",
        "description": "Search the HyperNexus skill registry for reusable capability modules (SKILL.md).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search text." },
            "limit": { "type": "number", "description": "Max results (default 8)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "skill_manage",
        "description": "List, read, or create HyperNexus skills (reusable SKILL.md capability modules).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["list", "read", "create"] },
            "name": { "type": "string", "description": "Skill name (for read/create)." },
            "content": { "type": "string", "description": "SKILL.md content (for create)." }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "code_search",
        "description": "Search code via the native router. Modes: symbols, definitions, references, files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Symbol, path pattern, or concept." },
            "mode": { "type": "string", "enum": ["symbols", "definitions", "references", "files"] },
            "limit": { "type": "number", "description": "Max results (default 10)." }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "knowledge_graph",
        "description": "Read the knowledge graph: entities and relations derived from memory (nodes/edges).",
        "inputSchema": {
          "type": "object",
          "properties": { "focus": { "type": "string", "description": "Optional entity or concept to focus on." } },
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "billing_status",
        "description": "Provider billing, quotas, depleted models, and the fallback chain.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "audit_log",
        "description": "Record an action to the HyperNexus audit/observation trail (compliance, RBAC evidence).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "description": "Action name, e.g. deploy." },
            "target": { "type": "string", "description": "Target: file path, URL, tool name." },
            "result": { "type": "string", "description": "Outcome." }
          },
          "required": ["action", "target"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "subagent",
        "description": "Record a task to L2 memory for tracking and later recall (tracked under category subagent).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task": { "type": "string", "description": "Task description." },
            "context": { "type": "string", "description": "Optional context." }
          },
          "required": ["task"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "workflow",
        "description": "List or run HyperNexus engineering workflows for orchestration.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "description": "list or run." },
            "id": { "type": "string", "description": "Workflow id (required for run)." }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "orchestrate",
        "description": "Run the RECALL-DISCOVER-PERSIST leg of the orchestration loop for a task: harvests memory, finds tools, records the task.",
        "inputSchema": {
          "type": "object",
          "properties": { "task": { "type": "string", "description": "The task to orchestrate." } },
          "required": ["task"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "browser",
        "description": "Browser automation: scrape a URL or check browser-service status. Degrades gracefully when the service is down.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "description": "status or scrape." },
            "url": { "type": "string", "description": "URL to scrape (required for scrape)." }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "memory_stats",
        "description": "Memory tier statistics: counts across L2 vault, scratchpad, and relation tiers.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "readOnly": true
      },
      {
        "name": "session_list",
        "description": "List recent sessions across harnesses (who ran what, where).",
        "inputSchema": {
          "type": "object",
          "properties": { "limit": { "type": "number", "description": "Max sessions (default 10)." } },
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "repomap",
        "description": "Generate a ranked repository map with symbol summaries for a directory (code navigation starting point).",
        "inputSchema": {
          "type": "object",
          "properties": { "dir": { "type": "string", "description": "Directory to map (default workspace root)." } },
          "additionalProperties": false
        },
        "readOnly": true
      }
    ]
  }
}
