// HyperNexus — Meta model wiring for Prime Agent (REFERENCE SNIPPET, no secrets inside).
// =============================================================================
// Model: muse-spark-1.3-contributor via Meta's OpenAI-compatible endpoint.
// Auth is an ENV-VAR NAME REFERENCE ONLY ("apiKey": "MODEL_API_KEY") — this file
// never contains a token. The variable is minted FRESH per run by
// use-meta-model.ps1 via bin/meta-muse-key.mjs (thin shim over the shared
// minter addons/shared/bin/meta-muse-key.mjs; stdout = key-only contract).
//
// USER-RUN ACTIVATION (minter pattern — nothing pasted, nothing stored):
//   .\use-meta-model.ps1 "hello"                      # mints fresh key, one-shot via -p
//   # ...or merge the "meta" block below into ~/.prime/agent/models.json
//   # under "providers", then launch (key still minted per run):
//   # prime-agent --provider meta --model muse-spark-1.3-contributor
//
// Verify: node addons/prime-agent/bin/meta-muse-key.mjs --check (key hidden).
// Presence-check only: this file carries the VARIABLE NAME, never a value.
{
  "providers": {
    "meta": {
      "baseUrl": "http://127.0.0.1:7778/v1",
      "apiKey": "MODEL_API_KEY",
      "api": "openai-completions",
      "models": [
        {
          "id": "muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "api": "openai-completions",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 131072
        }
      ]
    }
  }
}
